# Copiar a .env (raíz: seed) / worker/.env / web/.env.local y completar.

# --- Supabase (compartido) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# solo worker y seed (NUNCA en la web)
SUPABASE_SERVICE_ROLE_KEY=

# --- worker (Railway) ---
ANTHROPIC_API_KEY=
CLASSIFIER_MODEL=claude-haiku-5-5
# nombre de la persona protegida (aparece en las alertas y en /red)
PROTEGIDO_NOMBRE=Abuela Marta
# JID del grupo familiar (el worker lista los grupos al conectar)
FAMILY_GROUP_JID=
# teléfonos de confianza separados por coma (cualquier formato, se normalizan)
TRUSTED_CONTACTS=
# provincia que se asigna a los reportes del worker
PROVINCIA_DEFAULT=Santa Fe
# carpeta de la sesión de Baileys (en Railway: el mount path del volumen, ej. /data/auth_info)
AUTH_DIR=./auth_info
# opcional: transcripción de audios
OPENAI_API_KEY=

# --- web (Vercel) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
