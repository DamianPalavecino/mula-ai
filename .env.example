# Copiar a .env (raíz: seed) / worker/.env / web/.env.local y completar.

# --- Supabase (compartido) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# solo worker y seed (NUNCA en la web)
SUPABASE_SERVICE_ROLE_KEY=

# --- worker (VPS: ~/.config/mula-ai/worker.conf, ver docs/deploy.md §3) ---
# LLM del clasificador vía OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
CLASSIFIER_MODEL=deepseek/deepseek-v4-flash
# si el LLM no contestó en este tiempo y la heurística ya da alerta, se alerta con la heurística (ms)
CLASSIFIER_BUDGET_MS=3500
# nombre de la persona protegida (aparece en las alertas y en /red)
PROTEGIDO_NOMBRE=Abuela Marta
# a quién le llega la alerta de familia: un grupo (…@g.us, el worker lista los grupos al conectar) o una persona (549XXXXXXXXXX@s.whatsapp.net)
FAMILY_GROUP_JID=
# teléfonos de confianza separados por coma (cualquier formato, se normalizan)
TRUSTED_CONTACTS=
# si tiene números (coma), SOLO se analizan esos remitentes; el resto se ignora sin loguear.
# Usalo si vinculás un número personal: ponés acá el número desde el que mandás la estafa de prueba.
ANALIZAR_SOLO=
# provincia que se asigna a los reportes del worker
PROVINCIA_DEFAULT=Santa Fe
# carpeta de la sesión de Baileys (en el VPS: /home/agente/mula-data/auth_info, fuera del repo)
AUTH_DIR=./auth_info
# opcional: transcripción de audios
OPENAI_API_KEY=

# puerto del HTTP del worker (GET /health, POST /analizar)
PORT=8080

# --- web (Vercel) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# URL pública del worker (la usa /simulador; sin ella la web usa un mock)
NEXT_PUBLIC_WORKER_URL=
# /me-estafaron (server-only, nunca con NEXT_PUBLIC_): OPENROUTER_API_KEY (la misma de arriba) también en Vercel.
# opcional: modelo con visión de OpenRouter, default anthropic/claude-sonnet-5.5
EXTRACTOR_MODEL=
# opcional: habilita "Sumar mi caso a la red" (registrar_reporte con fuente victima). Solo en el server de Vercel.
# SUPABASE_SERVICE_ROLE_KEY=
# Worker: MULA_TOKEN (más abajo, el mismo valor en worker y web) = header X-Mula-Token que exige POST /analizar.
# Sin MULA_TOKEN el worker responde 401 a todo /analizar. HTTP_TOKEN_ENVIO es el nombre viejo (se sigue aceptando).
# Worker: único origen con CORS (ej. https://mula-ai.vercel.app). Vacío = sin Access-Control-Allow-Origin.
WEB_ORIGIN=

# Auth de la web (Clerk). Damian crea la app en clerk.com y carga las keys en el entorno local de web y en Vercel.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/entrar
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/entrar
# Emails con rol admin (gobierno), separados por coma. Server-only.
ADMIN_EMAILS=
# Worker desde el server de la web (nunca NEXT_PUBLIC_): URL HTTPS del VPS y token compartido con el worker.
WORKER_URL=
MULA_TOKEN=
